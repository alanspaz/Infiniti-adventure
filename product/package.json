{
  "name": "infinite-adventure",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "prestart": "node scripts/ensure-product-cwd.js",
    "start": "expo start",
    "start:clear": "node scripts/ensure-product-cwd.js && expo start -c",
    "start:tunnel": "node scripts/ensure-product-cwd.js && expo start --tunnel",
    "start:tunnel:clear": "node scripts/ensure-product-cwd.js && expo start -c --tunnel",
    "android": "node scripts/ensure-product-cwd.js && expo start --android",
    "ios": "node scripts/ensure-product-cwd.js && expo start --ios",
    "test": "node scripts/ensure-product-cwd.js && tsx --test engine/*.test.ts src/persist/*.test.ts src/settings/*.test.ts src/ai/*.test.ts",
    "typecheck": "node scripts/ensure-product-cwd.js && tsc --noEmit",
    "smoke": "node scripts/ensure-product-cwd.js && tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "babel-preset-expo": "~57.0.10",
    "expo": "~57.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=20 <25"
  }
}
